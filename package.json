{
  "name": "karmalab-tools",
  "version": "1.0.0",
  "description": "KarmaLab Tools — a multi-page web app of small React tools, built with Vite and served (with a Replicate proxy) by a small Node server.",
  "type": "module",
  "main": "server/index.js",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/karmalab-tech/karmalab-tools.git"
  },
  "bugs": {
    "url": "https://github.com/karmalab-tech/karmalab-tools/issues"
  },
  "keywords": [
    "replicate",
    "image-generation",
    "video-generation",
    "react",
    "vite"
  ],
  "packageManager": "yarn@1.22.22",
  "engines": {
    "node": ">=18.11"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node server/index.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "jszip": "^3.10.1",
    "mp4-muxer": "^5.2.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "webm-muxer": "^5.1.4"
  },
  "devDependencies": {
    "@eslint/js": "^9",
    "@tailwindcss/vite": "^4.3.2",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.11.0",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.2",
    "vite": "^6.0.7",
    "vitest": "^3"
  }
}
